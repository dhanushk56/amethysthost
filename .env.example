# --- App ---
PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx   # Stripe Price ID for the $5.99/mo plan
STRIPE_PRICE_PRO=price_xxx       # Stripe Price ID for the $11.99/mo plan

# --- Pterodactyl (your actual game panel that runs the servers) ---
PTERODACTYL_PANEL_URL=https://panel.yourdomain.com
PTERODACTYL_APP_API_KEY=ptla_xxx   # Admin -> Application API key

# Egg/Nest/Location IDs from your panel admin (Admin -> Nests/Eggs, Admin -> Locations)
PTERO_NEST_ID_FREE=1
PTERO_EGG_ID_FREE=1
PTERO_NEST_ID_PAID=1
PTERO_EGG_ID_PAID=1
PTERO_LOCATION_ID_NA=1

# Docker image + startup command for the Minecraft egg you're using
PTERO_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERO_STARTUP_CMD=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar server.jar
